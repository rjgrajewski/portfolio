# Copy to .env.local for local development (git-ignored).
#
# VITE_AGENT_URL — reasoning Lambda Function URL, the `AgentFunctionUrl`
# output of the `portfolio-api-<env>` CDK stack (docs/ARCHITECTURE.md
# § Real-time media transport). Leave unset to develop the frontend against
# the "assistant unavailable" fallback state.
VITE_AGENT_URL=

# VITE_CREDENTIALS_URL — credential-vending Lambda Function URL, the
# `CredentialsFunctionUrl` output of the `portfolio-identity-<env>` CDK
# stack (docs/ARCHITECTURE.md § Abuse protection — the OQ-8 fix). Leave
# unset to develop with voice OFF; text is unaffected either way.
VITE_CREDENTIALS_URL=
